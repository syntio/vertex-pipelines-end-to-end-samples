# Vertex Pipelines Development Environment Configuration
# Copy this file to 'dev.tfvars' and update with your values

# GCP Configuration
project_id = "your-project-id"
region     = "europe-west2"

# GitHub Actions Authentication (for CI/CD deployment)
github_repository_owner = "your-github-org"
github_repository_name  = "your-repo-name"

# Resource Naming
name_prefix = "ml-ops-turbo"  # Prefix to distinguish different ML workloads

# Workload Identity Pool is auto-generated from project_id + repository hash

# Optional: Cloud Scheduler Configuration (uncomment to enable scheduled pipeline runs)
