# Vertex Pipelines Development Environment Configuration

# GCP Configuration
project_id = "YOUR_PROJECT_ID"
region     = "europe-west2"

# GitHub Actions Authentication (for CI/CD deployment)
github_repository_owner = "YOUR_GITHUB_ORG"
github_repository_name  = "YOUR_REPO_NAME"

# Resource Naming
name_prefix = "ml-ops-turbo"

# Workload Identity Pool is auto-generated from project_id + repository hash
